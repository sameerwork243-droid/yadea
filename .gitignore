# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev server logs
dev.log
dev.err.log

# raw Google Flow downloads and intermediate encodes — regenerate with
# scripts/gt70-normalize.mjs rather than committing multi-hundred-MB video.
# Prompts, the manifest and QC reports under assets/gt70/ stay tracked.
assets/gt70/flow/raw/
assets/gt70/flow/approved/
assets/gt70/flow/rejected/
assets/gt70/processed/30fps/
